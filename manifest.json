{
  "manifest_version": 3,
  "name": "Bricks Infused",
  "description": "Voegt nieuwe functionaliteiten toe aan Bricks Huisarts.",
  "version": "2.3.0",
  "version_name": "v2.3.0 30-09-2026",
  "author": "Dokter Bart",
  "homepage_url": "https://dokterbart.nl/",
  "icons": {
    "16": "bricks-16.png",
    "32": "bricks-32.png",
    "48": "bricks-48.png",
    "128": "bricks-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bricks Infused"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://brickshuisarts.nl/*/*"
      ],
      "js": ["bridge_main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://brickshuisarts.nl/*/*"
      ],
      "js": [
        "lib/jspdf.umd.min.js",
        "bridge_client.js",
        "content.js",
        "content_uprevent.js",
        "content_juvoly_bricks.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://tandem.juvoly.nl/*",
        "https://app.juvoly.nl/*"
      ],
      "js": ["content_juvoly.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://tandem.juvoly.nl/*",
    "https://app.juvoly.nl/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["bricks-infused.svg", "bricks.svg"],
      "matches": [
        "https://brickshuisarts.nl/*",
        "https://tandem.juvoly.nl/*",
        "https://app.juvoly.nl/*"
      ]
    }
  ]
}
